{
  "name": "nestjs-saas-start",
  "version": "0.1.0-alpha",
  "description": "NestJS SaaS starter with best practices using Fastify, MikroORM, PostgreSQL, and Node/pnpm",
  "type": "module",
  "main": "dist/main.js",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build:libs": "cd libs/core && nest build --builder swc && cd ../.. && tsc --project libs/core/tsconfig.build.json --emitDeclarationOnly && cd libs/contracts && nest build --builder swc && cd ../.. && tsc --project libs/contracts/tsconfig.build.json --emitDeclarationOnly && cd libs/api-contract && nest build --builder swc && cd ../.. && tsc --project libs/api-contract/tsconfig.build.json --emitDeclarationOnly && cd libs/ba-mikro-adapter && nest build --builder swc && cd ../.. && tsc --project libs/ba-mikro-adapter/tsconfig.build.json --emitDeclarationOnly",
    "build:client": "pnpm --filter @saas/api-client run build",
    "build:nest": "nest build --builder swc",
    "build": "pnpm run build:libs && pnpm run build:client && pnpm run build:nest",
    "format": "biome format --write .",
    "start": "pnpm run build:libs && nest start",
    "start:dev": "pnpm run build:libs && nest start --watch",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:odoo-rpc-web": "pnpm --filter odoo-rpc-web dev",
    "build:odoo-rpc-web": "pnpm --filter odoo-rpc-web build",
    "start:debug": "pnpm run build:libs && nest start --debug --watch",
    "start:prod": "node dist/apps/api/src/main.js",
    "kill:dev": "pkill -f 'dist/apps/api/src/mai[n]' || true; pkill -f 'nest.js start --watc[h]' || true; pkill -f 'pnpm run start:de[v]' || true; pkill -f 'build:libs && nest star[t]' || true",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "fallow:arch": "fallow architecture",
    "ci": "node scripts/ci.ts",
    "ci:quick": "node scripts/ci.ts quick",
    "ci:db": "pnpm run check && pnpm run test && pnpm run test:fullstack",
    "verify:prod-boot": "node scripts/verify-prod-boot.ts",
    "verify:i18n-assets": "node scripts/verify-i18n-assets.ts",
    "verify:i18n-key-parity": "node scripts/verify-i18n-key-parity.ts",
    "verify:compose-contract": "node scripts/verify-compose-contract.ts",
    "verify:config-contract": "node scripts/verify-config-contract.ts",
    "verify:type-escape": "node scripts/verify-type-escape-ratchet.ts",
    "verify:type-escape:update": "node scripts/verify-type-escape-ratchet.ts --update",
    "verify:domain-layout": "node scripts/verify-domain-layout.ts",
    "verify:feature-isolation": "node scripts/verify-feature-isolation.ts",
    "verify:stories-drift": "node scripts/verify-stories-drift.ts",
    "verify:overturned-rulings": "node scripts/verify-overturned-rulings.ts",
    "verify:tenant-scoped-registry": "node scripts/verify-tenant-scoped-registry.ts",
    "verify:test-types": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p libs/core/tsconfig.json && tsc --noEmit -p libs/contracts/tsconfig.json && tsc --noEmit -p libs/ba-mikro-adapter/tsconfig.json && tsc --noEmit -p packages/api-client/tsconfig.test.json && tsc --noEmit -p scripts/tsconfig.json",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:auth-consistency": "vitest run --config vitest.consistency.config.ts",
    "test:fullstack": "tsx scripts/ci-fullstack.ts",
    "ci:e2e:web": "vitest run --config vitest.browser.config.ts",
    "test:e2e:web": "tsx scripts/e2e-web.ts",
    "migration:generate": "tsx scripts/mikro-migration-create.ts",
    "migration:run": "tsx scripts/mikro-migrate.ts",
    "db:seed": "tsx apps/api/src/database/seed.ts",
    "db:reset": "tsx scripts/mikro-migrate.ts --fresh && pnpm run db:seed",
    "db:setup": "tsx scripts/mikro-migrate.ts && pnpm run db:seed",
    "doctor:member-count": "tsx scripts/member-count-doctor.ts",
    "openapi:export": "pnpm run build && node dist/apps/api/src/openapi-codegen.js",
    "openapi:codegen": "node dist/apps/api/src/openapi-codegen.js",
    "verify:orpc-contract": "vitest run libs/api-contract/src/app-router.contract.test.ts apps/api/src/common/orpc/app-router.contract.test.ts",
    "docs:api": "typedoc"
  },
  "keywords": [],
  "author": {
    "name": "Abel 数字牧民",
    "email": "hl8org@gmail.com",
    "url": "https://github.com/FDE-GROUP/nestjs-saas-start"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@casl/ability": "^7.0.2",
    "@core/saas-kit": "workspace:*",
    "@fastify/compress": "^9.2.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@okee/ba-mikro-adapter": "workspace:*",
    "@orpc/client": "2.0.0-beta.44",
    "@orpc/contract": "2.0.0-beta.44",
    "@orpc/nest": "2.0.0-beta.44",
    "@orpc/openapi": "2.0.0-beta.44",
    "@orpc/server": "2.0.0-beta.44",
    "@saas/api-contract": "workspace:*",
    "@saas/contracts": "workspace:*",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "js-yaml": "^5.4.3",
    "mjml": "^5.4.1",
    "nestjs-i18n": "^10",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "tinyglobby": "0.2.17",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/test-utils": "1.7.7",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@playwright/test": "1.64.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/ali-oss": "^6.23.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/uuid": "^11.0.0",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "fallow": "3.33.0",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "testcontainers": "^12.2.1",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^5.0.4"
  }
}
