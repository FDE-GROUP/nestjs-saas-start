{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "incremental": false,
    "rootDir": "../../",
    "baseUrl": "../../",
    "paths": {
      "@core/saas-kit/*": ["libs/core/src/*"],
      "@saas/contracts": ["libs/contracts/src/index.ts"],
      "@saas/contracts/*": ["libs/contracts/src/*"]
    }
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["dist", "node_modules"]
}
