# dependencies
node_modules/
.pnpm-store/

# IDE
/.idea
/.awcache
*.code-workspace
# Qoder IDE wiki/cache workspace (local only, never committed)
.qoder/

# bundle
packages/**/*.d.ts
packages/**/*.js
# 前端 F1（module-frontend-api-client）：@saas/api-client 从 openapi.yaml 生成的契约类型刻意入库（同 routeTree.gen 惯例），
# 供无生成步骤即可消费/构建；仅放出生成契约类型，dist 编译产物仍由上方 `*.js` + `dist/` 规则忽略。
!packages/api-client/src/schema.d.ts

# misc
.DS_Store
lerna-debug.log
npm-debug.log
yarn-error.log
.env

coverage
.eslintcache

# playwright 部署态 e2e 产物（global-playwright-browser-e2e 切片 B·失败时截图/trace/报告·本地噪声不入库）
test-results/
playwright-report/

# build
build/
dist/
*.tsbuildinfo
tmp/
temp/

# runtime artifacts（pino file transport 落 ./logs，随起服生成，不入库）
logs/

.vercel

# other
.clinic
.cache
# .npmrc 需随库追踪以保证 registry 可复现（境内镜像 npmmirror），故不再忽略

#openapi
openapi/*.json
# 前端 F1（module-frontend-api-client）：openapi.yaml 作 codegen 产出的契约 SSOT 纳入版本控制，
# 供 ci 字节对拍防漂移与 @saas/api-client 生成消费（人令「你裁定」2026-10-17 采推荐档·高危门禁面签核在场）。
!openapi/openapi.yaml

# personal incubation workspace (oh-my-env) — 个人孵化层，不入库；其结论经提炼后落入 docs/specs（见 workflow.md）
oh-my-env/
# TypeDoc API reference output (generated locally/CI; not committed)
api-docs/

# Odoo 联调栈运行时产物（承 docker-compose.dev.yml·命名卷 pgadmin/DB 数据在 docker 侧·宿主应无残留·防御性登记）
# 自定义 addon 落点 odoo-addons/（bind /mnt/extra-addons）里若临时丢入 dump/sql/filestore 一律不入库（.gitkeep 仍追踪）
odoo-addons/*.dump
odoo-addons/*.sql
odoo-addons/.filestore/

# 治理文档私有仓 checkout 落点 docs-private/（原 `odoo/saas-addons/`·2026-10-28 开源边界重划后本仓转为纯文档仓、
# 目录名去 odoo/addons 误导）走独立私有仓·不入本公共仓（松耦合各推各的·remote github.com/FDE-GROUP/odoo-saas-start）。
# 首次 clone 本仓后需自行在该路径 git clone 私有文档仓。
docs-private/

# 治理文档 docs/（specs 宪法 / plans / stories / research 等）不入本公共仓·改由 odoo-saas-start 私有仓承载
# ./docs 为指向 docs-private/docs（私有仓 checkout）的软链：单一真源·本地 CI 恒等闸（读 docs/）经软链解析·开发不受影响。
# 全新 clone 本仓将无 docs/（需自行 clone 私有仓到 docs-private 并建软链 docs -> docs-private/docs）。
/docs

# Feature 叠加层已并入本公共仓常驻开源（开源边界重划 2026-10-28·sync-features 退役）：
# apps/api/src/features/** 现直接追踪，无「私有真源↔同步副本」防线之必要（旧防线随机制一并撤除）。
