# dependencies
node_modules/
.pnpm-store/

# IDE
/.idea
/.awcache
*.code-workspace
# Qoder IDE wiki/cache workspace (local only, never committed)
.qoder/

# bundle
packages/**/*.d.ts
packages/**/*.js
# 前端 F1（module-frontend-api-client）：@saas/api-client 从 openapi.yaml 生成的契约类型刻意入库（同 routeTree.gen 惯例），
# 供无生成步骤即可消费/构建；仅放出生成契约类型，dist 编译产物仍由上方 `*.js` + `dist/` 规则忽略。
!packages/api-client/src/schema.d.ts

# misc
.DS_Store
lerna-debug.log
npm-debug.log
yarn-error.log
.env

coverage
.eslintcache

# playwright 部署态 e2e 产物（global-playwright-browser-e2e 切片 B·失败时截图/trace/报告·本地噪声不入库）
test-results/
playwright-report/

# build
build/
dist/
*.tsbuildinfo
tmp/
temp/

# runtime artifacts（pino file transport 落 ./logs，随起服生成，不入库）
logs/

.vercel

# other
.clinic
.cache
# .npmrc 需随库追踪以保证 registry 可复现（境内镜像 npmmirror），故不再忽略

#openapi
openapi/*.json
# 前端 F1（module-frontend-api-client）：openapi.yaml 作 codegen 产出的契约 SSOT 纳入版本控制，
# 供 ci 字节对拍防漂移与 @saas/api-client 生成消费（人令「你裁定」2026-10-17 采推荐档·高危门禁面签核在场）。
!openapi/openapi.yaml

# personal incubation workspace (oh-my-env) — 个人孵化层，不入库；其结论经提炼后落入 docs/specs（见 workflow.md）
oh-my-env/
# TypeDoc API reference output (generated locally/CI; not committed)
api-docs/

# Odoo 20 CE 联调栈运行时产物（承 docker-compose.odoo.yml·命名卷在 docker 侧·宿主应无残留·防御性登记）
odoo/*.dump
odoo/*.sql
odoo/.filestore/

# 插件落点 odoo/saas-addons/ 走独立私有仓·不入本公共仓（承 module-local-odoo20-ce ⓓ 修订·松耦合各推各的）
# 首次 clone 本仓后需自行在该路径 git clone 私有插件仓；缺目录时 compose bind-mount 由 docker 自动建空目录
odoo/saas-addons/

# 治理文档 docs/（specs 宪法 / plans / stories / research 等）不入本公共仓·改由 odoo-saas-start 私有仓承载
# ./docs 为指向 odoo/saas-addons/docs（私有仓 checkout）的软链：单一真源·本地 CI 恒等闸（读 docs/）经软链解析·开发不受影响。
# 全新 clone 本仓将无 docs/（需自行 clone 私有仓到 odoo/saas-addons）。
/docs

# Feature 私有叠加层同步副本（承 odoo-saas-start docs/plans/module-odoo-rpc-frontend.md
# 切片 A）：真源在私有仓 server/features/，经 pnpm run sync:features 同步至此供编译——
# 未追踪副本，本防线结构性防私有源码误提交公共仓（非仅纪律）。装配桩 feature-loader.ts 相反
# 须追踪（公共仓常驻·缺席态展开为空）。逐叠加层显式登记，新 feature 同步时同处补行。
apps/api/src/features/odoo-rpc-api/
apps/api/src/features/odoo-provisioning/
