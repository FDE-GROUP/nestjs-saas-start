{
  "include": ["apps/**/*", "libs/**/*"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "paths": {
      "@app/*": ["apps/api/src/*"],
      "@modules/*": ["apps/api/src/modules/*"],
      "@shared-kernel/*": ["libs/core/src/shared-kernel/*"],
      "@config/*": ["apps/api/src/config/*"],
      "@common/*": ["apps/api/src/common/*"],
      "@shared/*": ["apps/api/src/shared/*"],
      "@core/saas-kit/*": ["libs/core/src/*"],
      "@saas/contracts": ["libs/contracts/src/index.ts"],
      "@saas/contracts/*": ["libs/contracts/src/*"],
      "@saas/api-contract": ["libs/api-contract/src/index.ts"],
      "@saas/api-contract/*": ["libs/api-contract/src/*"],
      "@okee/ba-mikro-adapter": ["libs/ba-mikro-adapter/src/index.ts"],
      "@okee/ba-mikro-adapter/*": ["libs/ba-mikro-adapter/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "prisma/**/*"]
}
