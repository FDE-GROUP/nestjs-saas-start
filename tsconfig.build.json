{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": ["apps/api/src/*"],
      "@modules/*": ["apps/api/src/modules/*"],
      "@config/*": ["apps/api/src/config/*"],
      "@common/*": ["apps/api/src/common/*"],
      "@shared/*": ["apps/api/src/shared/*"]
    }
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "coverage",
    "libs",
    "apps/web",
    "apps/odoo-rpc-web",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
