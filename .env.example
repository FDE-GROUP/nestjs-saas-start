# App Environment
NODE_ENV=development
API_DOC_VERSION=1.0.0
PORT=7009
HOST=localhost
API_PREFIX=api
APP_NAME=NestJS SaaS Start
APP_DESCRIPTION=NestJS template with best practices
API_VERSION=1.0
APP_URL=http://localhost:7009

# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_practice

# Seed（pnpm run db:seed / db:setup）
# seed.ts 开头自带 dotenv.config()，读的就是本文件所在的 .env（无需每次命令行内联传参）。
# 非生产缺这两个键：点名 warn 后使用内置弱口令灌库（平台经营者账号取 PLATFORM_OPERATOR_EMAIL·
# 兜底 admin@example.com；口令 admin123；演示用户 user{i}@example.com 口令 user123）。seed 经 Better Auth
# signUpEmail 亲自建 user + account credential（module-db-seed-ba-loginable-accounts），故上述账号现可**密码登录**。
# **生产环境（NODE_ENV=production）缺 `ADMIN_PASSWORD`/`USER_PASSWORD` 将拒跑 seed**（fail-loud·
# 先于建连·零弱口令上图）；配齐两键则照常可跑。只要库能被别人访问，就必须显式设置这两个键。
# ADMIN_PASSWORD=change-me
# USER_PASSWORD=change-me
# **破坏性开关**：置 true 时 seed 会先清空 session/account/verification/post/user 再灌，切勿在共享或生产库上开启。
# SEED_CLEANUP=false

# PIPL Data Residency Guard (C2 · D7)
# 默认策略：NODE_ENV=production 时 strict（境内 region 之外拒启），开发/测试 warn。
# 不填 = 按 NODE_ENV 自动；显式置 true 强制 strict、置 false 强制 warn。
# DATA_RESIDENCY_ENFORCE=
# 自建 IDC / 内网域名白名单（逗号分隔，仅当主机不在内置境内 allowlist 时才需）。
# 地址在境内而不在内置名单时，优先用本白名单放行，而不是关掉上面的守卫。
# DATA_RESIDENCY_DB_HOST_ALLOWLIST=db.my-idc.example.com

# Auth
# CORS 与 Better Auth trustedOrigins 的单一白名单源：逗号分隔的**完整 origin**（含 scheme，不含路径）。
# 生产未配 = fail-closed（拒所有跨源，同源/同域反代不受影响）。示例：
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7009
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=90d
# 反向代理可信网段 CIDR（逗号分隔）——限流信任链**双链单源**（module-common-rate-limit 乙裁）：
# ① BA 认证面自有限流（3次/10s）的 trustedProxies；② Nest 限流墙（300次/60s）经 Fastify
# trustProxy 解析 req.ip 分桶。两面同源防漂移。
# 不配 = **rate limit 的客户端 IP 可被伪造/反代后落共享桶误杀（防爆破形同虚设）**且 boot 期打一条 warn。
# 典型值：直连=loopback,127.0.0.1 · 单 nginx=loopback,127.0.0.1,172.x.x.x · 前置云 LB 再加一层。
# 注：docker-compose 里的 `AUTH_TRUSTED_PROXIES=172.16.0.0/12`（bridge 网段）**只解「拿到 IP」
# 不解「拿到对的 IP」**——若 nginx 在宿主网络而应用容器在 bridge，真实访客 IP 仍在
# 172.16.0.0/12 之外，多跳链需从右往左逐级列出；compose 部署请宿主 nginx 与容器同网络。
# AUTH_TRUSTED_PROXIES=loopback,127.0.0.1

# Logging
# 日志级别（error/warn/log/debug/verbose）；不填 = 非生产全开（含 verbose）、生产仅 error。
# LOG_LEVEL=log
# 文件日志路径（JSON lines）；不填 = 不落文件，仅 stdout（容器 / systemd 自行收集时可不配）。
# LOG_FILE=/var/log/nestjs-api/app.log

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=your-email@gmail.com

# Storage（默认阿里云 OSS，境内 region）
STORAGE_PROVIDER=alioss
STORAGE_BUCKET=my-bucket
STORAGE_REGION=oss-cn-hangzhou
STORAGE_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_ACCESS_KEY_SECRET=your-access-key-secret
STORAGE_BASE_URL=https://my-bucket.oss-cn-hangzhou.aliyuncs.com
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Storage - S3 / 兼容 MinIO（uncomment to use）
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=my-bucket
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=s3.us-east-1.amazonaws.com
# STORAGE_ACCESS_KEY_ID=your-access-key-id
# STORAGE_ACCESS_KEY_SECRET=your-access-key-secret
# STORAGE_BASE_URL=https://my-bucket.s3.us-east-1.amazonaws.com
# STORAGE_MAX_FILE_SIZE=10485760
# STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Storage - Tencent COS (uncomment to use)
# STORAGE_PROVIDER=tencentoss
# STORAGE_BUCKET=my-bucket
# STORAGE_REGION=ap-guangzhou
# STORAGE_ACCESS_KEY_ID=your-secret-id
# STORAGE_ACCESS_KEY_SECRET=your-secret-key
# STORAGE_BASE_URL=https://my-bucket.cos.ap-guangzhou.myqcloud.com
# STORAGE_MAX_FILE_SIZE=10485760
# STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_API_VERSION=2025-02-24.acacia
# 支付渠道选择器（stripe|alipay）；未配 = stripe。alipay 本期仅配置面占位（实现劣后暂缓，见
# global-cn-adaptation F1）——**填了也不会启用**，真实支付链路仍只有 stripe。
# PAYMENT_PROVIDER=stripe

# OAuth Configuration
# 已提供配置槽位的渠道：github / apple / google（在 config/envs/default.ts 的 oauth.secrets）。
# 只列入本行才会尝试注册；无槽位 / 无凭证的已列入渠道：**非生产给一条 boot warn，生产直接拒启**
# （social provider 不会凭空出现，光放 *_CLIENT_ID 不生效）。
OAUTH_PROVIDERS=github,apple
OAUTH_CALLBACK_URL_BASE=http://localhost:7009/api/v1/auth/callback
OAUTH_COOKIE_NAME=auth_session
OAUTH_COOKIE_MAX_AGE=2592000
OAUTH_COOKIE_SECURE=false

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth Providers - Apple (example)
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# OAuth Providers - Google（已有槽位 · 切片 A-1）
# 启用需同时满足：列入上方 OAUTH_PROVIDERS + 下面两项非空。
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 境内登录渠道（方案 C · genericOAuth；email 为体、社交为用）
# 逗号分隔的 providerId；未列即不注册（不配凭证可正常启动）。本期实现：feishu。
# （wechat / dingtalk / wecom 仅留接口位，实现劣后暂缓，勿在此启用）
# 已声明但未注册的渠道（接口位 / 缺凭证 / 拼错 id）会在 boot 期给一条自述真因的 warn（含生产），
# 但**不拒启**——generic 面保留 NFR-2「未配即降级」语义（与 social 面的生产 fail-loud 有意不同）。
OAUTH_GENERIC_PROVIDERS=feishu
# OAuth Providers - 飞书 / Lark
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# Swagger Documentation
OPEN_API_VERSION=3.1.0

# 平台经营者（FR-13 · S5）：全局唯一 operator email，由开发者设定（seed 保障其行存在）。
# 平台级动作（审批/暂停/恢复/删除/跨租列表）唯一判据 = 会话用户 email 命中此值。
PLATFORM_OPERATOR_EMAIL=admin@example.com

# ES 发布通道三模开关（module-es-outbox-transactional · 裁点乙）：inproc|shadow|outbox，
# 三套 envs 缺省统一 inproc（纯进程内、不触库；取代旧 EVENT_STORE_ENABLED 布尔）。
# shadow=耐久 append 后立即派发（旧 true 语义）；outbox=同事务 append + relay 投递。
# 开启前提：目标库已 apply event 投递列迁移；outbox 误开（事务外 publishAll）= fail-loud。
EVENT_PUBLISH_MODE=inproc
# outbox relay 轮询间隔（ms，仅 mode=outbox 有意义）
EVENT_OUTBOX_POLL_MS=1000

# ES R4 第二上下文推广写切换（module-es-r4-second-context-subscriptions §3-R4c·高危#1 逐次亲签）：订阅治理
# convergeStatus/create 写路径是否翻为「回放即真相」（load→fold 裁决→append(expectedVersion 乐观锁·同事务)→投影 upsert）。
# 缺省 false=原 CRUD 写逐字节不变（回退窗）；开启前提：已对目标库跑 es-bootstrap-subscriptions 使存量成流（R4b）。
ES_TRUTH_SOURCE_SUBSCRIPTIONS=false

# 过期 session 回收周期任务（module-session-index-and-expiry-reclaim F2）：缺省关（未置 true 即不启
# timer·不触库·保 DB-free）。开启后定期 nativeDelete(expiresAt < now)，走 session_expires_at_idx。
# SESSION_RECLAIM_ENABLED=true
# 回收轮询间隔（ms，缺省 3600000=1h）
# SESSION_RECLAIM_INTERVAL_MS=3600000
