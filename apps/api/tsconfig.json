{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@app/*": ["src/*"],
      "@modules/*": ["src/modules/*"],
      "@config/*": ["src/config/*"],
      "@common/*": ["src/common/*"],
      "@shared/*": ["src/shared/*"],
      "@shared-kernel/*": ["../../libs/core/src/shared-kernel/*"],
      "@core/saas-kit/*": ["../../libs/core/src/*"],
      "@saas/contracts": ["../../libs/contracts/src/index.ts"],
      "@saas/contracts/*": ["../../libs/contracts/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
