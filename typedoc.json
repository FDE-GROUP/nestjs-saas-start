{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "libs/contracts/src/index.ts",
    "libs/core/src/shared-kernel",
    "libs/core/src/authorization",
    "libs/core/src/tenant-isolation",
    "libs/core/src/platform",
    "libs/core/src/modules/organizations",
    "libs/core/src/modules/workspaces",
    "libs/core/src/modules/subscriptions",
    "apps/api/src/modules/posts/api",
    "apps/api/src/modules/posts/domain",
    "apps/api/src/modules/posts/application",
    "apps/api/src/modules/subscriptions/api",
    "apps/api/src/modules/workspaces/api",
    "apps/api/src/modules/platform/api",
    "apps/api/src/modules/payment/api",
    "apps/api/src/modules/payment/application",
    "apps/api/src/modules/payment/domain",
    "apps/api/src/modules/auth/api",
    "apps/api/src/modules/auth/domain",
    "apps/api/src/modules/auth/auth.constant.ts",
    "apps/api/src/modules/authorization/api",
    "apps/api/src/modules/authorization/application",
    "apps/api/src/modules/authorization/domain",
    "apps/api/src/modules/users/api",
    "apps/api/src/modules/users/application",
    "apps/api/src/modules/users/domain"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.doc.json",
  "out": "docs/api-ref",
  "name": "公共 API 参考（@saas/contracts + @core/saas-kit + apps/api 对外接口）",
  "readme": "none",
  "commentStyle": "jsdoc",
  "exclude": ["**/*.test.ts", "**/*.spec.ts"],
  "excludeNotDocumented": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "cleanOutputDir": true,
  "validation": {
    "notExported": true,
    "invalidLink": true
  }
}
