{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "libs/contracts/src/index.ts",
    "libs/core/src/shared-kernel",
    "libs/core/src/authorization",
    "libs/core/src/tenant-isolation",
    "libs/core/src/platform",
    "libs/core/src/modules/organizations"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.doc.json",
  "out": "docs/api-ref",
  "name": "公共 API 参考（@saas/contracts + @core/saas-kit）",
  "readme": "none",
  "commentStyle": "jsdoc",
  "exclude": ["**/*.test.ts", "**/*.spec.ts"],
  "excludeNotDocumented": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "cleanOutputDir": true,
  "validation": {
    "notExported": true,
    "invalidLink": true
  }
}
